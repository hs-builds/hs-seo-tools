# Google Apps Script
.clasp.json
.claspignore

# Node modules (if using clasp or other tools)
node_modules/
package-lock.json
yarn.lock

# IDE specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
*~

# Test files
test/
*.test.js

# Personal notes
notes.txt
TODO.md

# Screenshots folder (keep the folder, ignore contents during development)
screenshots/*.png
screenshots/*.jpg
screenshots/*.gif
!screenshots/.gitkeep

# Backup files
*.bak
backup/

# Coverage reports
coverage/
.nyc_output/
